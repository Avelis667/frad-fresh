NODE_ENV=development
PORT=3000

# локальная БД (пример)
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/appdb?schema=public"
SHADOW_DATABASE_URL="postgresql://app:app@127.0.0.1:5432/appdb_shadow?schema=public"

# JWT/PEPPER — сгенерируешь перед запуском
JWT_SECRET=
PEPPER=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Владелец
OWNER_EMAIL=
OWNER_SUPER=false
